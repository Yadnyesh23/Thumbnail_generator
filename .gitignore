```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
.venv/
env/
ENV/

# Environment Variables
.env
.env.*

# Python Build Files
build/
dist/
*.egg-info/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Type Checkers
.mypy_cache/
.pyright/
.ruff_cache/

# IDEs
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log

# SQLite Database
*.db
*.sqlite3

# ==========================
# FastAPI
# ==========================
uploads/
temp/
tmp/

# ==========================
# Node / React / Vite
# ==========================
node_modules/

# Build Output
dist/
build/

# Vite
.vite/

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# Misc
# ==========================
*.swp
*.swo
```
